# Copie este arquivo para /opt/racha/app/.env e preencha.
# NUNCA versione o .env real nem a chave JSON (o .gitignore já bloqueia).

GOOGLE_SA_JSON=/opt/racha/app/google-sa.json
SHEET_ID=1EI7Qet2-Hhsyg5ywJi0A54tsx8Ectu5Jx0m9YjqQJb8

# --- Fase 2 (bot do Telegram) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_ID=
# ANTHROPIC_API_KEY=

# --- Fase 3 (Pix automático via Efí) ---
# EFI_CLIENT_ID=
# EFI_CLIENT_SECRET=
# EFI_CERT_PATH=/opt/racha/app/efi-racha.pem   (converter o .p12 -> .pem, veja README)
# EFI_PIX_KEY=
# EFI_SANDBOX=false
# MENSALIDADE_VALOR=90
# PIX_WEBHOOK_TOKEN=<gere-um-segredo-aleatorio>   (vai no caminho da URL do webhook)
# PIX_WEBHOOK_PORT=8090
# PANEL_REFRESH_CMD=/opt/racha/app/deploy/gerar-panel.sh   (atualiza o site na hora do pagamento)
