[Unit]
Description=Fecha a lista de presenca do sabado (quem nao respondeu vira "Nao vou")
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=racha
WorkingDirectory=/opt/racha/app
EnvironmentFile=/opt/racha/app/.env
ExecStart=/opt/racha/venv/bin/python presenca_auto.py
